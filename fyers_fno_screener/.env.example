SCREENER_PASSWORD=replace-with-a-long-private-password
FLASK_SECRET_KEY=replace-with-a-long-random-secret
COOKIE_SECURE=true

# Zerodha Kite Connect
KITE_API_KEY=your-kite-api-key
KITE_API_SECRET=your-kite-api-secret
